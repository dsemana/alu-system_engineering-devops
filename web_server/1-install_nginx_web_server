#!/usr/bin/env bash
# Installs nginx server (works in containers / non-systemd systems)

apt-get update -y
apt-get install -y nginx

# Write content
echo "Holberton School" > /var/www/html/index.html

# Start nginx (without systemd)
service nginx start || true
service nginx restart || true

# Ensure port 80 is open (if ufw exists)
ufw allow 80/tcp || true